# Copia este fichero como .env y rellena tus valores reales.
# .env está en .gitignore, nunca se sube al repositorio.

INFINIANALYTICS_TOKEN=your_organization_token
INFINIANALYTICS_AUTOMATION_ID=your_automation_id

# Opcional: otro entorno de la API (por defecto, producción).
# INFINIANALYTICS_BASE_URL=https://api.analytics.infini.es
